{
  "expo": {
    "name": "MoTECH-i",
    "slug": "motech-i-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.benytech.motechi"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#070b12"
      },
      "package": "com.benytech.motechi",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow MoTECH-i to track your location for emergency SOS dispatch."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MoTECH-i to choose a profile photo from your library."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "backendUrl": "http://192.168.1.33:5000",
      "supabaseUrl": "https://djeedzoydsieonwerven.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqZWVkem95ZHNpZW9ud2VydmVuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMzODc5MDAsImV4cCI6MjA5ODk2MzkwMH0.0oLFBE-OSIPk3FtcHEOp1V9A3BtuW7XHInSWmiuRl1c",
      "router": {},
      "eas": {
        "projectId": "djeedzoydsieonwerven"
      }
    }
  }
}
